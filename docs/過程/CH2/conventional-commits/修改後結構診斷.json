      "references": {},
      "sop": [
        {
          "phase": 1,
          "title": "判斷與交付",
          "steps": [
            {
              "step": 1,
              "verb": "READ",
              "text": "`READ` 使用者需求與提供的變更摘要或待審查訊息；依 repository 產生訊息時，讀取 `git status`、`git diff --staged`，沒有 staged 時讀取 `git diff`，建立「本次輸入」。"
            },
            {
              "step": 2,
              "verb": "READ",
              "text": "`READ` 有專案環境時，讀取適用的 CONTRIBUTING 規範、commitlint 設定與 `git log --oneline -30`，建立「專案慣例」；沒有專案環境時採用本 Skill 的預設慣例。"
            },
            {
              "step": 3,
              "verb": "THINK",
              "text": "`THINK` 從「本次輸入」找出修改目的，依開頭的來源分類區分官方規格、官方建議、業界慣例與團隊規則。"
            },
            {
              "step": 4,
              "verb": "THINK",
              "text": "`THINK` 確認是否為單一 logical change；混了多個無關目的時，依官方 FAQ 建議拆成多個 commit，提出拆分方式與各自的 message。"
            },
            {
              "step": 5,
              "verb": "THINK",
              "text": "`THINK` 依 Decision Tree 與「專案慣例」決定 type。"
            },
            {
              "step": 6,
              "verb": "THINK",
              "text": "`THINK` 決定 scope：優先遵守專案明文規則；沒有規則時沿用既有慣例，再以功能、模組、package 或 domain 為預設建議。檔名若能代表影響區域，也可以使用；scope 的官方要求見格式區。"
            },
            {
              "step": 7,
              "verb": "THINK",
              "text": "`THINK` 判斷是否破壞既有使用方式（API、設定、資料格式、公開介面）；依格式區的官方規定處理 breaking 標示。"
            },
            {
              "step": 8,
              "verb": "WRITE",
              "text": "`WRITE` 撰寫或審查 description：使用祈使句，說明實際改了什麼；`fix: fix bug`、`update`、`misc changes` 不合格。語言優先依專案明文規則，再沿用 git log 慣例。"
            },
            {
              "step": 9,
              "verb": "WRITE",
              "text": "`WRITE` 需要時補充 body：為什麼改、之前發生什麼、為什麼選這種解法。小改動不用 body。"
            },
            {
              "step": 10,
              "verb": "CHECK",
              "text": "`CHECK` 依格式區、判斷規則、「專案慣例」及送出前檢查逐項核對訊息或審查結論；未通過時修正後重查。"
            },
            {
              "step": 11,
              "verb": "DELEGATE",
              "text": "`DELEGATE` 使用者明確要求 commit 時才使用 Git 建立 commit；只要求訊息或審查時交付文字結果，不變更 index 或檔案。"
            }
          ],
          "completion": "完成條件：訊息或審查結論已通過檢查，規則來源可辨識，且 Git 操作符合使用者授權範圍。"
        }
      ]
    }
  ]
