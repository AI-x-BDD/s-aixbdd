  "scenes": [
    {
      "frame": "01",
      "title": "由下而上組合",
      "text": "這是我做出的 Skill Engineering。它把分工明確的小技能組合起來，用來新建 Skill，也用來優化既有 Skill。",
      "visual": "六張主圖中的第一張。先看「8 支 primitives → 1 支 orchestrator → 3 支成果」，右側交代新建／優化兩種任務。",
      "evidence": "E1、E2"
    },
    {
      "frame": "02",
      "title": "primitives 的分工",
      "text": "這套基礎技能分成兩組。Form 負責把關各個部位。Form Description 寫清楚各支技能的用途與使用時機；Form SOP 整理執行流程。規則要有正反例；樣板提供骨架和範例；腳本寫清楚輸入輸出。三支 Deriver，從流程步驟抽出部位，再接回流程。",
      "visual": "上方 form-sop；下方 Rule／Template／Script 三欄，分別呈現 derive → form。依旁白點亮 Form 與三種部位的具體要求，再說明 Deriver，介紹 Form Description 的用途與使用時機。",
      "evidence": "E3–E6、E10–E16"
    },
    {
      "frame": "03",
      "title": "Engineering 如何調度",
      "text": "收到任務，Engineering 先定義預期。優化時先找問題與根因，確認後再提藍圖。施工先用 Form SOP 整理流程。步驟需要規則、固定輸出或自動化，就交給對應的 Deriver。它呼叫 Form 建立檔案，也把讀取或執行時機接回流程，避免檔案建好了，流程卻沒有使用它。既有部位只改內容，就直接交給 Form。這三支優化主要走 SOP 和 Rule；Template 和 Script 依任務需要選用。最後完成檢查與驗收。",
      "visual": "先呈現定義預期、優化才走的根因確認、藍圖確認；接著點亮 SOP，三條可選抽取路徑，再回到 SOP 載入／執行。末段顯示既有部位只改內容可直交 Form，以及本次主要走 SOP／Rule。",
      "evidence": "E1–E5"
    },
    {
      "frame": "04",
      "title": "慣例式提交的前後差異",
      "text": "我用這套流程優化三支技能。慣例式提交，把混在主檔的規則，拆成變更分類、提交訊息和歷史處理。",
      "visual": "同版型前後卡：左側流程、分類與訊息規則混合；右側 SOP 與三份規則。",
      "evidence": "E7"
    },
    {
      "frame": "05",
      "title": "主幹式開發的前後差異",
      "text": "主幹式開發，從流程與判準混寫，改成 SOP 加三份規則，依規劃或審查用途載入。",
      "visual": "沿用同版型：左側混寫；右側 SOP 與 TBD 判準、變更規劃、工作流程評估。",
      "evidence": "E8"
    },
    {
      "frame": "06",
      "title": "雙鑽石的前後差異",
      "text": "雙鑽石，原本混在一起的模型說明、分流與分析，現在由 SOP 負責流程，判準、任務分流與需求分析分開管理。",
      "visual": "沿用同版型：左側模型、分流與分析混合；右側三份規則。頁尾交代 SOP 負責流程；判準、任務分流與需求分析分開管理。",
      "evidence": "E9"
    },
    {
      "frame": "01",
      "title": "組合後的成果",
      "text": "三支技能都完成 SOP 與規則分工。同一套 primitives 可以重複組合，保留三支技能的領域用途，各自依任務讀取規則。",
      "visual": "回到第一張組合總覽，三份成果並列收尾。",
      "evidence": "E1、E2、E7–E9"
    }
  ],
